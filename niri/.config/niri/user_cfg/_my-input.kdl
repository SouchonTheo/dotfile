// Replaces cfg/input.kdl (niri keeps the LAST input{} block, so include after it).

input {
    // the power key goes to the XF86PowerOff bind instead
    // (+ HandlePowerKey=ignore in /etc/systemd/logind.conf.d/00-power-key.conf)
    disable-power-key-handling

    keyboard {
        xkb {
            // layout "us"
        }
        numlock
    }

    touchpad {
        tap
        click-method "clickfinger"
    }

    mouse {
        // accel-profile "flat"
        // accel-speed 0.0
    }

    focus-follows-mouse
    // cursor follows keyboard focus, or a small nudge gives focus back to the old window
    warp-mouse-to-focus
    workspace-auto-back-and-forth
}

gestures {
    hot-corners {
        off
    }
}
