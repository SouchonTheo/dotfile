// Overrides + additions on top of cfg/keybinds.kdl (included after it: last one wins).
// niri has no unbind, so the vanilla combos replaced here stay active too.

binds {

    // ─── Apps ───
    Mod+Return                          hotkey-overlay-title="Open Terminal: Ghostty" { spawn "ghostty"; }
    Mod+B                               hotkey-overlay-title="Open Browser: Helium" { spawn "helium-browser"; }
    Mod+Shift+C                         hotkey-overlay-title="Open Claude" { spawn "helium-browser" "--app=https://claude.ai" "--class=claude"; }
    Mod+Shift+S                         hotkey-overlay-title="Open Slack" { spawn "slack"; }
    Mod+A                               hotkey-overlay-title="Open AI: claude" { spawn "gtk-launch" "brave-fmpnliohjhemenmnlpbfagaolkdacoja-Default"; }

    // ─── Noctalia ───
    Mod+Space                           hotkey-overlay-title="Open App Launcher: noctalia launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+Shift+E                         hotkey-overlay-title="Spawn Emoji Picker: noctalia emoji" { spawn-sh "noctalia msg panel-toggle launcher '/emo'"; }
    Mod+Shift+V                         hotkey-overlay-title="Clipboard manager: noctalia" { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Alt+Tab                             hotkey-overlay-title="Window switcher: noctalia" { spawn-sh "noctalia msg window-switcher"; }
    // needs HandlePowerKey=ignore in logind + disable-power-key-handling (_my-input.kdl)
    XF86PowerOff                        allow-when-locked=true { spawn-sh "noctalia msg panel-toggle session"; }

    // ─── Clipboard (Mod+C replaces vanilla center-column) ───
    Mod+C                               hotkey-overlay-title="Copy (Ctrl+C)" { spawn-sh "wtype -M ctrl -k Insert -m ctrl"; }
    Mod+V                               hotkey-overlay-title="Paste (Shift+Insert)" { spawn-sh "wtype -M shift -k Insert -m shift"; }
    Mod+X                               hotkey-overlay-title="Cut (Ctrl+X)" { spawn-sh "wtype -M ctrl -k x -m ctrl"; }

    // ─── Screenshots (region/screen through noctalia's editor) ───
    Print                               hotkey-overlay-title="Screenshot region: noctalia" { spawn-sh "noctalia msg screenshot-region"; }
    Shift+Print                         hotkey-overlay-title="Screenshot screen: noctalia" { spawn-sh "noctalia msg screenshot-fullscreen"; }
    CTRL+Print                          { screenshot-window; }

    // ─── Layout ───
    Mod+F                               { maximize-column; }
    Mod+R                               { switch-preset-column-width; }
    Mod+Shift+R                         { switch-preset-window-height; }
    Mod+Ctrl+R                          { reset-window-height; }

    // ─── Monitors (vim keys, same as the Mod+Shift(+CTRL)+arrow vanilla ones) ───
    Mod+Shift+H                         { focus-monitor-left; }
    Mod+Shift+J                         { focus-monitor-down; }
    Mod+Shift+K                         { focus-monitor-up; }
    Mod+Shift+L                         { focus-monitor-right; }
    Mod+Shift+CTRL+H                    { move-column-to-monitor-left; }
    Mod+Shift+CTRL+J                    { move-column-to-monitor-down; }
    Mod+Shift+CTRL+K                    { move-column-to-monitor-up; }
    Mod+Shift+CTRL+L                    { move-column-to-monitor-right; }

    // ─── Workspaces ───
    Mod+Shift+1                         { move-column-to-workspace 1; }
    Mod+Shift+2                         { move-column-to-workspace 2; }
    Mod+Shift+3                         { move-column-to-workspace 3; }
    Mod+Shift+4                         { move-column-to-workspace 4; }
    Mod+Shift+5                         { move-column-to-workspace 5; }
    Mod+Shift+6                         { move-column-to-workspace 6; }
    Mod+Shift+7                         { move-column-to-workspace 7; }
    Mod+Shift+8                         { move-column-to-workspace 8; }
    Mod+Shift+9                         { move-column-to-workspace 9; }
}
