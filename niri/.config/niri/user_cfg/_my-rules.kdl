// Added on top of cfg/rules.kdl (window rules stack, no need to repeat vanilla ones).

// dim inactive windows
// window-rule {
//     match is-active=false
//     opacity 0.85
// }

// Picture-in-Picture: small, floating, bottom-right, never steals focus.
// Title differs per browser/locale, hence the case-insensitive alternation.
window-rule {
    match title=r#"(?i)^(picture[- ]in[- ]picture|image dans l'image)$"#
    open-floating true
    open-focused false
    // on-xdg-activate "set-urgent"  // stop pages re-raising it, needs a newer niri
    default-floating-position x=24 y=24 relative-to="bottom-right"
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    focus-ring { off; }
    border { off; }
}
